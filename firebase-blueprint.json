{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and roles",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "ADMIN",
            "RECRUITER",
            "CANDIDATE"
          ]
        },
        "subscription": {
          "type": "string",
          "enum": [
            "FREE",
            "PREMIUM"
          ]
        },
        "photoURL": {
          "type": "string"
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "firstName",
        "lastName",
        "email",
        "role",
        "subscription",
        "isActive"
      ]
    },
    "CV": {
      "title": "Candidate CV",
      "description": "Legacy simulator CV or server-owned canonical parsed CV",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "uid": {
          "type": "string"
        },
        "fileName": {
          "type": "string"
        },
        "fileURL": {
          "type": "string"
        },
        "aiScore": {
          "type": "number"
        },
        "feedback": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "PROCESSED",
            "FAILED"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "isCurrent": {
          "type": "boolean"
        },
        "parsedData": {
          "type": "object",
          "description": "Canonical sanitized CVStructuredData used by future server-side matching"
        },
        "file": {
          "type": "object",
          "properties": {
            "originalName": { "type": "string" },
            "mimeType": { "type": "string" },
            "sizeBytes": { "type": "number" },
            "sha256": { "type": "string" }
          }
        },
        "parsing": {
          "type": "object",
          "properties": {
            "schemaVersion": { "type": "number" },
            "parserVersion": { "type": "string" },
            "mode": { "type": "string", "enum": ["deterministic", "hybrid"] },
            "pageCount": { "type": "number" },
            "extractionMethod": { "type": "string" },
            "warnings": { "type": "array" }
          }
        }
      },
      "required": [
        "uid",
        "status",
        "createdAt"
      ]
    },
    "Job": {
      "title": "Job Posting",
      "description": "Legacy job or server-owned canonical matcher-ready job (schemaVersion 1)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "recruiterId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "OPEN",
            "CLOSED"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "schemaVersion": {
          "type": "number"
        },
        "required_skills": {
          "type": "array"
        },
        "preferred_skills": {
          "type": "array"
        },
        "minimum_experience_years": {
          "type": "number"
        },
        "maximum_experience_years": {
          "type": ["number", "null"]
        },
        "required_education": {
          "type": "object"
        },
        "required_languages": {
          "type": "array"
        },
        "remote_allowed": {
          "type": "boolean"
        },
        "work_mode": {
          "type": ["string", "null"],
          "enum": ["onsite", "hybrid", "remote", null]
        },
        "contract_type": {
          "type": ["string", "null"],
          "enum": ["CDI", "CDD", "Freelance", "Stage", "Alternance", null]
        },
        "mandatory_requirements": {
          "type": "array"
        }
      },
      "required": [
        "recruiterId",
        "title",
        "description",
        "company",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles by UID"
    },
    "cvs/{cvId}": {
      "schema": "CV",
      "description": "Candidate CV documents"
    },
    "jobs/{jobId}": {
      "schema": "Job",
      "description": "Job positions created by Recruiters"
    }
  }
}
