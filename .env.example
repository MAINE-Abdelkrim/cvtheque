# Root Node/Express environment. Copy to .env and replace placeholders.

# Firebase browser client (public Firebase application identifiers, not Admin secrets).
# firebase-applet-config.json is also supported as a local fallback.
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# Firebase Admin (server only). An explicit credential file takes precedence,
# followed by these three variables, then the legacy root file for rollback.
FIREBASE_CREDENTIALS_FILE=
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-example@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

# CV Parser integration (server only).
CV_PARSER_API_URL=http://127.0.0.1:8001
CV_PARSER_TIMEOUT_MS=60000
CV_UPLOAD_MAX_BYTES=10485760
CV_PARSER_VERSION=local-unversioned

# Matching Engine integration (server only).
MATCHING_ENGINE_URL=http://127.0.0.1:8002
MATCHING_ENGINE_TIMEOUT_MS=30000

# Interview Engine integration (server only; never expose the token to browser code).
INTERVIEW_ENGINE_BASE_URL=http://127.0.0.1:8003
INTERVIEW_ENGINE_API_TOKEN=
INTERVIEW_ENGINE_TIMEOUT_MS=30000

# Optional Job-description import. Manual Job creation works without this key.
GEMINI_API_KEY=

# Optional profile-avatar storage. Profile text editing works without these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
