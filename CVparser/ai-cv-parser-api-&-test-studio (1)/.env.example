# API Configuration
APP_NAME="AI CV Parser API"
APP_HOST="127.0.0.1"
APP_PORT=8000
NEXTJS_ORIGIN="http://localhost:3000"
LOG_LEVEL="INFO"
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=20

# AI Model Configuration (Qwen2.5-0.5B-Instruct default)
MODEL_NAME="Qwen/Qwen2.5-0.5B-Instruct"
MODEL_ENABLED=false
# Providers: pytorch (existing Transformers fallback) or llama_cpp (local GGUF)
MODEL_PROVIDER="pytorch"
# Relative or absolute local path. Do not commit the GGUF file.
MODEL_GGUF_PATH="models/qwen2.5-0.5b-instruct-gguf/qwen2.5-0.5b-instruct-q4_k_m.gguf"
MODEL_N_THREADS=4
MODEL_CONTEXT_SIZE=1024
# Set MODEL_LOCAL_FILES_ONLY=false for initial model download, then true for offline execution
MODEL_LOCAL_FILES_ONLY=true
# Generic default: auto. Override to "cpu" for low VRAM Windows GPU setups (e.g., MX330 2GB).
MODEL_DEVICE="auto"
MODEL_TORCH_DTYPE="auto"
MODEL_MAX_NEW_TOKENS=512
MODEL_DO_SAMPLE=false
MODEL_TEMPERATURE=0.0
MODEL_TOP_P=0.9
MODEL_REPETITION_PENALTY=1.1
MODEL_TRUST_REMOTE_CODE=false
MODEL_TIMEOUT_SECONDS=30

# OCR and Extraction Settings
MIN_NATIVE_TEXT_CHARS_PER_PAGE=50
MIN_NATIVE_TEXT_RATIO=0.6
OCR_LANGUAGES="fra+eng"
# Optional absolute path; useful when a long-running Windows process has an old PATH.
TESSERACT_CMD=""
OCR_LAYOUT_MODE="auto"

# Optional Skills Taxonomy / Catalog Path
SKILLS_CATALOG_PATH=""
