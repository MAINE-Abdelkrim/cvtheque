{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:parser": "cd \"CVparser/ai-cv-parser-api-&-test-studio (1)\" && .venv-llm\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8001",
    "dev:matching": "cd matching-engine && python -m uvicorn app.api.fastapi_app:app --host 127.0.0.1 --port 8002 --workers 1 --no-access-log",
    "dev:interview": "cd interviewEngine && python -m uvicorn app.main:app --host 127.0.0.1 --port 8003 --workers 1 --no-access-log",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:cv": "tsx --test tests/cv-integration.test.ts",
    "test:jobs": "tsx --test tests/job-integration.test.ts",
    "test:matching": "tsx --test tests/matching-adapter.test.ts tests/matching-integration.test.ts tests/matching-client.test.ts",
    "test:contracts": "tsx --test tests/contracts/contract-fixtures.test.ts",
    "test:interviews": "tsx --test tests/interview-client.test.ts tests/interview-integration.test.ts",
    "test:interview-frontend": "tsx --test tests/interview-frontend-client.test.ts tests/interview-frontend-state.test.ts",
    "test:candidate-jobs": "tsx --test tests/candidate-open-jobs.test.ts",
    "test:interview-history": "tsx --test tests/interview-history.test.ts tests/interview-history-frontend.test.ts",
    "test:admin": "tsx --test tests/admin-security.test.ts",
    "test:auth": "tsx --test tests/auth-ux.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.81.0",
    "sonner": "^2.0.7",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
